{
  "name": "dsh-qq-workspace",
  "version": "0.3.0",
  "private": true,
  "description": "QQ bot working directory, workspace grouping, upload routing, context management, long-term memory and a QQ-session security lock for DSH (Desktop and Web)",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "security.js",
    "context.js",
    "qq-commands.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check context.js && node --check security.js && node --check qq-commands.js",
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-desktop",
    "qqbot",
    "qq",
    "workspace",
    "security",
    "dsh-web",
    "compaction",
    "context",
    "memory",
    "long-term-memory"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irislilymoon/dsh-qq-workspace.git"
  },
  "bugs": {
    "url": "https://github.com/irislilymoon/dsh-qq-workspace/issues"
  },
  "homepage": "https://github.com/irislilymoon/dsh-qq-workspace#readme"
}
